# ============================================================
# FRONTEND ENV TEMPLATE
# ============================================================
# Copy file ini ke:
#   - .env.development  (untuk development)
#   - .env.production   (untuk production)
#
# ⚠️ JANGAN commit .env.development atau .env.production!
# ⚠️ File ini HANYA template — isi value asli di file masing-masing.
# ============================================================

# ============================================================
# BACKEND API
# ============================================================
# Development: http://localhost:8080/api
# Production:  https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# ============================================================
# APP CONFIG
# ============================================================
# development | production
VITE_APP_ENV=development

# Nama aplikasi (tampil di title default & meta tag)
VITE_APP_NAME=Portfolio Platform

# URL aplikasi (untuk share link, OG tag, redirect)
# Development: http://localhost:5173
# Production:  https://portfolio-platform.vercel.app
VITE_APP_URL=http://localhost:5173

# ============================================================
# CLOUDINARY (Image Upload)
# ============================================================
# Cloud name dari dashboard Cloudinary
# Login → cloudinary.com → Dashboard → Cloud name
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Upload preset (harus unsigned)
# Setup: Cloudinary Dashboard → Settings → Upload → Add upload preset
#   - Name: portfolio_unsigned
#   - Signing Mode: Unsigned
#   - Folder: portfolio
VITE_CLOUDINARY_UPLOAD_PRESET=portfolio_unsigned

# ============================================================
# FEATURE FLAGS
# ============================================================
# Enable analytics (GA, Vercel Analytics)
# false → development, true → production
VITE_ENABLE_ANALYTICS=false

# Enable debug mode (console.log, debug panel)
# true → development, false → production
VITE_ENABLE_DEBUG=true

# Enable mock API (untuk development tanpa backend)
VITE_ENABLE_MOCK=false

# ============================================================
# CUSTOM DOMAIN (Advanced)
# ============================================================
# Enable fitur custom domain per user
# false → development, true → production
VITE_CUSTOM_DOMAIN_ENABLED=false